# Allowlist .gitignore — track only source (.c/.h) and Makefiles.
# Anything not explicitly re-allowed below is ignored.

/*

# Project metadata
!/.gitignore
!/.gitmodules

# Top-level Makefile (only)
!/Makefile

# Submodule pointer (orion-sdk). Required so `git submodule status` works.
!/external

# Source tree: directory in, then narrow to .c / .h only
!/src
/src/*
!/src/*.c
!/src/*.h

# Note: tests/ is intentionally NOT re-allowed and stays ignored.
